# ABOUTME: Caddy config Railpack uses instead of its default when this file exists at the project root.
# ABOUTME: Railpack's Node template plus cache headers: hashed assets for a year, HTML revalidated, media for a day.

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # trust railway's proxy
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Vite fingerprints everything under /assets, so a changed file always has a new name.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Art, slides, fonts and the film keep their names across deploys; a day is the trade between speed and a fix landing.
	@media path /art/* /slides/* /fonts/* /film/* /architecture/*.png /architecture/*.webp /favicon* /apple-touch-icon.png /icon-512.png
	header @media Cache-Control "public, max-age=86400"

	# Pages always revalidate, so a deploy shows up on the next load.
	@pages path / *.html */
	header @pages Cache-Control "no-cache"

	root * dist

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	# Static pages first, then the home page as the fallback for share links and old anchors.
	try_files {path} {path}.html {path}/index.html /index.html
}
