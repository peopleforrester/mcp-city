# ABOUTME: Caddy config Railpack uses instead of its default when this file exists at the project root.
# ABOUTME: Railpack's Node template plus cache headers: hashed assets for a year, HTML revalidated, media for a day.

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # trust railway's proxy
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Vite fingerprints everything under /assets, so a changed file always has a new name.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Art, slides, fonts and the film keep their names across deploys; a day is the trade between speed and a fix landing.
	@media path /art/* /slides/* /fonts/* /film/* /og/* /architecture/*.png /architecture/*.webp /favicon* /apple-touch-icon.png /icon-512.png
	header @media Cache-Control "public, max-age=86400"

	# Pages always revalidate, so a deploy shows up on the next load.
	@pages path / *.html */
	header @pages Cache-Control "no-cache"
	@bare path_regexp ^/[^.]*[^/]$
	header @bare Cache-Control "no-cache"

	root * dist

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	# Every page is a real file; share links and the deck's QR codes all point at real paths, so there is no fallback.
	try_files {path} {path}.html {path}/index.html

	# Anything else is a real 404, served with the not-found page.
	handle_errors {
		@notfound expression {err.status_code} == 404
		# An error must never be cached as if it were the asset it replaced.
		header Cache-Control "no-store"
		handle @notfound {
			rewrite * /404/index.html
			file_server
		}
		respond {err.status_code}
	}
}
